# Public build-time values for every app in this monorepo.
#
# Copy this file to `.env.local` at the repository root (git-ignored). Every
# app loads it through createNextConfig() in @typhed/next-config, so one file
# configures web, trading, and blogging. These NEXT_PUBLIC_* values ship to the
# browser; they are not secrets. In CI each one is a GitHub Actions repository
# Variable of the same name, and every NEXT_PUBLIC_* Variable reaches every
# build.

# Clerk publishable key, shared by every property so one sign-in works on every
# *.typhed.com subdomain. Locally, use the Clerk *development* key: the
# production key only works on typhed.com hostnames. Leave it empty to run with
# auth off (every gate passes through).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Blog analytics and monetisation. Each renders nothing until its id is set.
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google AdSense publisher id, e.g. ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Microsoft Clarity project id, e.g. abcdefghij
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Search Console HTML-tag verification token (the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
