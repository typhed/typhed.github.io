# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Production / misc
dist/

# Generated by shared/documents/scripts/sync-shared.mjs before every dev run and
# every build: the brand artwork is copied from shared/documents/assets/brand and
# the theme stylesheet is written from brand/tokens/colors.json. Editing either
# by hand is silently overwritten on the next build - change the source in the
# shared.documents submodule instead.
apps/web/app/theme.css
apps/web/public/brand/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables (never commit real analytics / AdSense IDs as secrets;
# non-secret NEXT_PUBLIC_* values are set as repository Variables for CI)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Vercel (unused here, kept to avoid accidental commits)
.vercel
