{
  // An assets-only Worker: Cloudflare serves the static export in ./out, no script runs.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "typhed-blogging",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    // Next exports route/index.html (trailingSlash: true); /route redirects to /route/.
    "html_handling": "auto-trailing-slash",
    // Serve out/404.html for unknown paths.
    "not_found_handling": "404-page"
  },
  // The live hostname. The proxied DNS record for it stays in the typhed.com zone.
  "routes": [{ "pattern": "blog.typhed.com/*", "zone_name": "typhed.com" }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
