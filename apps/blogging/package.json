{
  "name": "blogging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The blog.typhed.com static export: MDX posts with LaTeX and build-time syntax highlighting.",
  "scripts": {
    "dev": "typhed-brand-sync && next dev --port 3002",
    "build": "typhed-brand-sync && next build",
    "preview": "wrangler dev --port 8789",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf .next out .turbo .wrangler"
  },
  "dependencies": {
    "@typhed/auth": "workspace:*",
    "@typhed/brand": "workspace:*",
    "@typhed/ui": "workspace:*"
  },
  "devDependencies": {
    "@typhed/next-config": "workspace:*",
    "@typhed/tailwind-config": "workspace:*",
    "@typhed/tsconfig": "workspace:*"
  }
}
