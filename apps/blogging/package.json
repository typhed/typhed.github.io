{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "The blog.typhed.com static export: MDX posts with LaTeX and build-time syntax highlighting.",
  "scripts": {
    "sync:shared": "node ../../shared/documents/scripts/sync-shared.mjs --assets public/brand --theme app/theme.css",
    "predev": "pnpm run sync:shared",
    "dev": "next dev",
    "prebuild": "pnpm run sync:shared",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@clerk/react": "^6.12.2",
    "@typhed/brand": "workspace:*",
    "@typhed/ui": "workspace:*",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.16.0",
    "next": "^15.1.6",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reading-time": "^1.5.0",
    "recharts": "^3.9.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "^2.6.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typhed/tailwind-config": "workspace:*",
    "@typhed/tsconfig": "workspace:*",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
