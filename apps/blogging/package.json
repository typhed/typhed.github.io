{
  "name": "blogging",
  "version": "0.1.0",
  "private": true,
  "description": "The blog.typhed.com static export: MDX posts with LaTeX and build-time syntax highlighting.",
  "scripts": {
    "dev": "typhed-brand-sync && next dev --port 3002",
    "build": "typhed-brand-sync && next build",
    "preview": "wrangler dev --port 8789",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out .turbo .wrangler node_modules"
  },
  "dependencies": {
    "@typhed/auth": "workspace:*",
    "@typhed/brand": "workspace:*",
    "@typhed/ui": "workspace:*",
    "clsx": "catalog:",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.11",
    "lucide-react": "catalog:",
    "mermaid": "^11.16.0",
    "next": "catalog:",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reading-time": "^1.5.0",
    "recharts": "^3.9.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "catalog:",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typhed/next-config": "workspace:*",
    "@typhed/tailwind-config": "workspace:*",
    "@typhed/tsconfig": "workspace:*",
    "autoprefixer": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "postcss": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
