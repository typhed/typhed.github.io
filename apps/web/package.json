{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "typhed-brand-sync && next dev --port 3000",
    "build": "typhed-brand-sync && next build && python ../../permalink/src/build.py --output out/permalink --redirects out/_redirects",
    "preview": "wrangler dev --port 8787",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out .turbo .wrangler"
  },
  "dependencies": {
    "@typhed/auth": "workspace:*",
    "@typhed/brand": "workspace:*",
    "@typhed/ui": "workspace:*"
  },
  "devDependencies": {
    "@typhed/next-config": "workspace:*",
    "@typhed/tailwind-config": "workspace:*",
    "@typhed/tsconfig": "workspace:*"
  }
}
