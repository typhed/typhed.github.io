# Clerk publishable key (public, safe to expose in the client bundle).
# Reuse the SAME key as the TyPhed main site and blog so the session cookie
# is shared across every *.typhed.com subdomain. When this is empty the app
# builds and runs with authentication turned OFF (CLERK_ENABLED = false).
#
# Copy this file to apps/web/.env.local and fill in the value. Next reads env
# files from this directory (apps/web), not the repository root.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
