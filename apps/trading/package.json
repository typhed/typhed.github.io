{
  "name": "trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "typhed-brand-sync && next dev --port 3001",
    "build": "typhed-brand-sync && next build",
    "preview": "wrangler dev --port 8788",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf .next out .turbo .wrangler"
  },
  "dependencies": {
    "@typhed/auth": "workspace:*",
    "@typhed/backtest": "workspace:*",
    "@typhed/brand": "workspace:*",
    "@typhed/chart-engine": "workspace:*",
    "@typhed/risk-toolkit": "workspace:*",
    "@typhed/ui": "workspace:*"
  },
  "devDependencies": {
    "@typhed/next-config": "workspace:*",
    "@typhed/tailwind-config": "workspace:*",
    "@typhed/tsconfig": "workspace:*"
  }
}
