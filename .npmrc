strict-peer-dependencies=false
auto-install-peers=true

# The app's `predev` / `prebuild` hooks run sync-shared.mjs, which generates
# app/theme.css and copies the brand artwork. pnpm's default for this setting is
# not pinned across versions, so it is declared explicitly: without it the theme
# stylesheet is never generated and the build fails on a missing import.
enable-pre-post-scripts=true
